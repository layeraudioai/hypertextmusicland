  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "build": {
    "appId": "com.66ghz.hypertextmusicland",
    "productName": "HYPERTEXTMUSICLAND",
    "files": [
      "dist/index.html",
      "dist/icon.png",
      "dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "dist/icon.png"
