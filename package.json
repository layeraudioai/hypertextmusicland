    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "install": "^0.13.0",
    "jest": "^30.5.1",
    "jsx": "^0.9.89",
    "jszip": "^3.10.1",
    "lamejs": "^1.2.1",
    "lucide-react": "^0.546.0",
    "mespeak": "^2.0.2",
    "minimist": "^1.2.8",
    "mocha": "^12.0.0",
    "motion": "^12.23.24",
    "node-gyp": "^13.0.2",
    "optimist": "^0.5.2",
    "postinstall": "^0.11.2",
    "qs": "^6.16.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "spessasynth_core": "^4.3.22",
    "three": "^0.186.0",
